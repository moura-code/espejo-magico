{
  "name": "espejo-magico",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --watch-preserve-output servidor/servidor.js",
    "start": "node servidor/servidor.js",
    "test": "vitest run",
    "test:mirar": "vitest",
    "listo": "vitest run --config vitest.listo.config.js",
    "catalogo": "node -e \"import('./servidor/catalogo.js').then(m => m.generarArchivoCatalogo())\"",
    "vendorizar": "node herramientas/vendorizar.mjs",
    "prepare": "sh scripts/setup-git-hooks.sh || echo hooks no activados",
    "planilla": "node herramientas/planilla.mjs"
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "^1.0.0",
    "vitest": "^4.1.10"
  }
}
